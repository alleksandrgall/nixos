{
  "$schema": "https://opencode.ai/config.json",
  "model": "anthropic/claude-opus-5-5",
  "small_model": "deepseek/deepseek-chat",
  "lsp": true,
  "instructions": [
    "~/.local/share/opencode/memory/learned.md"
  ],
  "permission": {
    "*": "ask",
    "read": "allow",
    "edit": "allow",
    "glob": "allow",
    "grep": "allow",
    "list": "allow",
    "lsp": "allow",
    "todowrite": "allow",
    "todoread": "allow",
    "bash": "ask",
    "external_directory": {
      "*": "ask",
      "~/.local/share/opencode/memory/**": "allow"
    }
  },
  "agent": {
    "build": {
      "variant": "max"
    }
  }

}
