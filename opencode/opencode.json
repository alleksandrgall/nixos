{
  "$schema": "https://opencode.ai/config.json",
  "model": "anthropic/claude-opus-5-5",
  "small_model": "deepseek/deepseek-chat",
  "lsp": true,
  "permission": {
    "*": "ask",
    "read": "allow",
    "edit": "allow",
    "glob": "allow",
    "grep": "allow",
    "list": "allow",
    "lsp": "allow",
    "todowrite": "allow",
    "todoread": "allow",
    "bash": "ask",
    "external_directory": "ask"
  },
  "agent": {
    "build": {
      "variant": "max"
    }
  }

}
